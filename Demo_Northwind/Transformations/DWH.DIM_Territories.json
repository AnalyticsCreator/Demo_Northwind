  "viewDefinition": "CREATE VIEW [DWH].[DIM_Territories] AS\r\nSELECT\r\n\t[SATZ_ID] = ISNULL([T1].[SATZ_ID], 0),\r\n\t[DAT_VON_HIST] = [T1].[DAT_VON_HIST],\r\n\t[DAT_BIS_HIST] = [T1].[DAT_BIS_HIST],\r\n\t[TerritoryDescription] = ISNULL([T1].[TerritoryDescription], 'N.A.'),\r\n\t[RegionID] = ISNULL([T1].[RegionID], 0),\r\n\t[TerritoryID] = RTRIM(LTRIM(ISNULL([T1].[TerritoryID], 'N.A.')))\r\nFROM\r\n\t[STG].[Territories] T1 (NOLOCK)\r\nWHERE\r\n\t1 = 1\r\nUNION ALL SELECT \r\n\t[SATZ_ID] = 0,\r\n\t[DAT_VON_HIST] = '19000101',\r\n\t[DAT_BIS_HIST] = '99991231',\r\n\t[TerritoryDescription] = ISNULL(NULL, 'N.A.'),\r\n\t[RegionID] = ISNULL(NULL, 0),\r\n\t[TerritoryID] = RTRIM(LTRIM(ISNULL(NULL, 'N.A.')))",
