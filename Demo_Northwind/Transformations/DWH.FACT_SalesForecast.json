  "viewDefinition": "CREATE VIEW [DWH].[FACT_SalesForecast] AS\r\nSELECT\r\n\t[FK_Date] = CASE\r\n    WHEN DATEFROMPARTS(T1.Year, T1.Month, 1) < '19800101' THEN 0 \r\n    WHEN DATEFROMPARTS(T1.Year, T1.Month, 1) > '20401231' THEN CONVERT(bigint, DATEDIFF(DD, '19800101',  '20401231') + 1)\r\n    ELSE CONVERT(bigint, ISNULL(DATEDIFF(DD, '19800101', CONVERT(date, DATEFROMPARTS(T1.Year, T1.Month, 1))) + 1, 0))\r\nEND,\r\n\t[FK_Customer] = [T2].[SATZ_ID],\r\n\t[FK_Product] = [T3].[SATZ_ID],\r\n\t[Amount] = [T1].[Total]\r\nFROM\r\n\t[DWH].[SalesForecast] [T1] (NOLOCK)\r\n\tLEFT JOIN [STG].[Customers] [T2] (NOLOCK) ON \r\n\t\tT2.CustomerID = T1.CustomerID\r\n\tLEFT JOIN [STG].[Products] [T3] (NOLOCK) ON \r\n\t\tT3.ProductID = T1.ProductID AND \r\n\t\t[T3].[DAT_BIS_HIST] = '99991231'\r\nWHERE\r\n\t1 = 1",
