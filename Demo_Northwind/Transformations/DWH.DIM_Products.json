  "viewDefinition": "CREATE VIEW [DWH].[DIM_Products] AS\r\nSELECT\r\n\t[SATZ_ID] = ISNULL([T1].[SATZ_ID], 0),\r\n\t[DAT_VON_HIST] = [T1].[DAT_VON_HIST],\r\n\t[DAT_BIS_HIST] = [T1].[DAT_BIS_HIST],\r\n\t[ProductName] = RTRIM(LTRIM(ISNULL([T1].[ProductName], 'N.A.'))),\r\n\t[SupplierID] = ISNULL([T1].[SupplierID], 0),\r\n\t[CategoryID] = ISNULL([T1].[CategoryID], 0),\r\n\t[QuantityPerUnit] = RTRIM(LTRIM(ISNULL([T1].[QuantityPerUnit], 'N.A.'))),\r\n\t[UnitPrice] = ISNULL([T1].[UnitPrice], 0),\r\n\t[UnitsInStock] = ISNULL([T1].[UnitsInStock], 0),\r\n\t[UnitsOnOrder] = ISNULL([T1].[UnitsOnOrder], 0),\r\n\t[ReorderLevel] = ISNULL([T1].[ReorderLevel], 0),\r\n\t[Discontinued] = ISNULL([T1].[Discontinued], 0),\r\n\t[ProductID] = ISNULL([T1].[ProductID], 0)\r\nFROM\r\n\t[STG].[Products] T1 (NOLOCK)\r\nWHERE\r\n\t1 = 1\r\nUNION ALL SELECT \r\n\t[SATZ_ID] = 0,\r\n\t[DAT_VON_HIST] = '19000101',\r\n\t[DAT_BIS_HIST] = '99991231',\r\n\t[ProductName] = RTRIM(LTRIM(ISNULL(NULL, 'N.A.'))),\r\n\t[SupplierID] = ISNULL(NULL, 0),\r\n\t[CategoryID] = ISNULL(NULL, 0),\r\n\t[QuantityPerUnit] = RTRIM(LTRIM(ISNULL(NULL, 'N.A.'))),\r\n\t[UnitPrice] = ISNULL(NULL, 0),\r\n\t[UnitsInStock] = ISNULL(NULL, 0),\r\n\t[UnitsOnOrder] = ISNULL(NULL, 0),\r\n\t[ReorderLevel] = ISNULL(NULL, 0),\r\n\t[Discontinued] = ISNULL(NULL, 0),\r\n\t[ProductID] = ISNULL(NULL, 0)",
