  "viewDefinition": "CREATE VIEW [TRN].[SalesInfo] AS\r\nSELECT\r\n\t[Year] = YEAR([T2].[OrderDate]),\r\n\t[Month] = MONTH([T2].[OrderDate]),\r\n\t[CustomerID] = ISNULL([T2].[CustomerID], 'N.A.'),\r\n\t[ProductID] = ISNULL([T1].[ProductID], 0),\r\n\t[Total] = SUM(T1.Quantity*T1.UnitPrice*(1-T1.Discount))\r\nFROM\r\n\t[STG].[Order Details] [T1] (NOLOCK)\r\n\tLEFT JOIN [STG].[Orders] [T2] (NOLOCK) ON \r\n\t\t[T2].[OrderID] = T1.[OrderID]\r\nWHERE\r\n\t[T1].[DAT_BIS_HIST] = '99991231' AND\r\n\t1 = 1\r\nGROUP BY\r\n\t YEAR([T2].[OrderDate]),\r\n\tMONTH([T2].[OrderDate]),\r\n\tISNULL([T2].[CustomerID], 'N.A.'),\r\n\tISNULL([T1].[ProductID], 0)",
