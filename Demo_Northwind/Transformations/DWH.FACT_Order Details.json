  "createDummyEntry": false,
  "transHistTypeID": 3,
  "viewDefinition": "CREATE VIEW [DWH].[FACT_Order Details] AS\r\nSELECT\r\n\t[FK_SNAPSHOT] = [SNAPSHOTS].[SnapshotID],\r\n\t[FK_Order Details] = ISNULL([T1].[SATZ_ID], 0),\r\n\t[FK_Orders] = ISNULL([T2].[SATZ_ID], 0),\r\n\t[FK_Customers] = ISNULL([T3].[SATZ_ID], 0),\r\n\t[FK_Employees] = ISNULL([T4].[SATZ_ID], 0),\r\n\t[FK_ReportsTo] = ISNULL([T5].[SATZ_ID], 0),\r\n\t[FK_Shippers] = ISNULL([T6].[SATZ_ID], 0),\r\n\t[FK_Products] = ISNULL([T7].[SATZ_ID], 0),\r\n\t[FK_Categories] = ISNULL([T8].[SATZ_ID], 0),\r\n\t[FK_Suppliers] = ISNULL([T9].[SATZ_ID], 0),\r\n\t[FK_OrderDate] = CASE\r\n    WHEN [T2].[OrderDate] < '19800101' THEN 0 \r\n    WHEN [T2].[OrderDate] > '20401231' THEN CONVERT(bigint, DATEDIFF(DD, '19800101',  '20401231') + 1)\r\n    ELSE CONVERT(bigint, ISNULL(DATEDIFF(DD, '19800101', CONVERT(date, [T2].[OrderDate])) + 1, 0))\r\nEND,\r\n\t[FK_RequiredDate] = CASE\r\n    WHEN [T2].[RequiredDate] < '19800101' THEN 0 \r\n    WHEN [T2].[RequiredDate] > '20401231' THEN CONVERT(bigint, DATEDIFF(DD, '19800101',  '20401231') + 1)\r\n    ELSE CONVERT(bigint, ISNULL(DATEDIFF(DD, '19800101', CONVERT(date, [T2].[RequiredDate])) + 1, 0))\r\nEND,\r\n\t[FK_ShippedDate] = CASE\r\n    WHEN [T2].[ShippedDate] < '19800101' THEN 0 \r\n    WHEN [T2].[ShippedDate] > '20401231' THEN CONVERT(bigint, DATEDIFF(DD, '19800101',  '20401231') + 1)\r\n    ELSE CONVERT(bigint, ISNULL(DATEDIFF(DD, '19800101', CONVERT(date, [T2].[ShippedDate])) + 1, 0))\r\nEND,\r\n\t[UnitPrice] = [T1].[UnitPrice],\r\n\t[Quantity] = [T1].[Quantity],\r\n\t[Discount] = [T1].[Discount],\r\n\t[Total] = T1.UnitPrice*T1.Quantity*(1-T1.Discount)\r\nFROM\r\n\t[CFG].[SNAPSHOTS] [SNAPSHOTS] (NOLOCK)\r\n\tLEFT JOIN [STG].[Order Details] [T1] (NOLOCK) ON \r\n\t\t[SNAPSHOTS].[Date] BETWEEN [T1].[DAT_VON_HIST] AND [T1].[DAT_BIS_HIST]\r\n\tLEFT JOIN [STG].[Orders] [T2] (NOLOCK) ON \r\n\t\t[T2].[OrderID] = T1.[OrderID] AND \r\n\t\t[SNAPSHOTS].[Date] BETWEEN [T2].[DAT_VON_HIST] AND [T2].[DAT_BIS_HIST]\r\n\tLEFT JOIN [STG].[Customers] [T3] (NOLOCK) ON \r\n\t\t[T3].[CustomerID] = T2.[CustomerID] AND \r\n\t\t[SNAPSHOTS].[Date] BETWEEN [T3].[DAT_VON_HIST] AND [T3].[DAT_BIS_HIST]\r\n\tLEFT JOIN [STG].[Employees] [T4] (NOLOCK) ON \r\n\t\t[T4].[EmployeeID] = T2.[EmployeeID] AND \r\n\t\t[SNAPSHOTS].[Date] BETWEEN [T4].[DAT_VON_HIST] AND [T4].[DAT_BIS_HIST]\r\n\tLEFT JOIN [STG].[Employees] [T5] (NOLOCK) ON \r\n\t\t[T5].[EmployeeID] = T4.[ReportsTo] AND \r\n\t\t[SNAPSHOTS].[Date] BETWEEN [T5].[DAT_VON_HIST] AND [T5].[DAT_BIS_HIST]\r\n\tLEFT JOIN [STG].[Shippers] [T6] (NOLOCK) ON \r\n\t\t[T6].[ShipperID] = T2.[ShipVia] AND \r\n\t\t[SNAPSHOTS].[Date] BETWEEN [T6].[DAT_VON_HIST] AND [T6].[DAT_BIS_HIST]\r\n\tLEFT JOIN [STG].[Products] [T7] (NOLOCK) ON \r\n\t\t[T7].[ProductID] = T1.[ProductID] AND \r\n\t\t[SNAPSHOTS].[Date] BETWEEN [T7].[DAT_VON_HIST] AND [T7].[DAT_BIS_HIST]\r\n\tLEFT JOIN [STG].[Categories] [T8] (NOLOCK) ON \r\n\t\t[T8].[CategoryID] = T7.[CategoryID] AND \r\n\t\t[SNAPSHOTS].[Date] BETWEEN [T8].[DAT_VON_HIST] AND [T8].[DAT_BIS_HIST]\r\n\tLEFT JOIN [STG].[Suppliers] [T9] (NOLOCK) ON \r\n\t\t[T9].[SupplierID] = T7.[SupplierID] AND \r\n\t\t[SNAPSHOTS].[Date] BETWEEN [T9].[DAT_VON_HIST] AND [T9].[DAT_BIS_HIST]\r\nWHERE\r\n\tSNAPSHOTS.SnapshotID IN (1)",
